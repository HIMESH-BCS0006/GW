# Waypoint Delivery Planning System - Environment Configuration
PROJECT_NAME="Waypoint Delivery Planning System"
ENV="development"
DEMO_MODE=true
DEMO_NOW="2025-07-31T14:00:00+05:30"
TIMEZONE="Asia/Colombo"

# Database Configuration
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint_secret
POSTGRES_DB=waypoint_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://waypoint:waypoint_secret@db:5432/waypoint_db

# Security & Auth
SECRET_KEY="waypoint_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Logging
LOG_LEVEL="INFO"
